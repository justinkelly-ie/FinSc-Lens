package FinSc-Lens
version = 0.1.0
authors = "Justin"
brief   = "FinSc-Lens: Non-Perturbing Horizons, Probes, Topological Relics & Readout Audits"

depends = base >= 0.8.0
        , linear
        , FinSc-Box
        , Finite-Science

sourcedir = "src"

modules = FinScLens.Horizons
        , FinScLens.Measurements
        , FinScLens
        , Main

main       = Main
executable = "finsc-lens-audits"
