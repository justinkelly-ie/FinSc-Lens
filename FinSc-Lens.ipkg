package FinSc-Lens
version = 0.3.0
authors = "Justin"
brief   = "FinSc-Lens: Non-Perturbing Horizons, Probes, Projective/Frame Readouts & Relics"

depends = base >= 0.8.0
        , linear
        , FinSc-Box
        , FinSc-Space

sourcedir = "src"

modules = FinScLens.Horizons
        , FinScLens.Measurements
        , FinScLens
