package FinSc-Lens
version = 0.2.0
authors = "Justin"
brief   = "FinSc-Lens: Non-Perturbing Horizons, Probes, Topological Relics & Readout Library"

depends = base >= 0.8.0
        , linear
        , FinSc-Box
        , FinSc-Dynamics

sourcedir = "src"

modules = FinScLens.Horizons
        , FinScLens.Measurements
        , FinScLens
